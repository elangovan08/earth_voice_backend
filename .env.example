# Copy this file to .env only for local reference, or set these as
# environment variables in your IDE run configuration.
# Do not commit real secrets.

# Database
# Use the JDBC URL from Neon/Render. Include ?sslmode=require for Neon.
DATABASE_URL=jdbc:postgresql://ep-example.neon.tech/blogdb?sslmode=require
DB_USERNAME=your_neon_username
DB_PASSWORD=your_neon_password

# JWT
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION_MINUTES=60

# Email notifications
# Gmail requires an App Password. Do not use your normal Gmail password.
NOTIFICATIONS_ENABLED=true
NOTIFICATION_RECIPIENT=elangovandev27@gmail.com
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_sender_gmail@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_FROM_NAME=Elangovan
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
NOTIFICATION_FROM=your_sender_gmail@gmail.com

# Hugging Face image generation
HF_TOKEN=your_hugging_face_token
HF_IMAGE_MODEL=stabilityai/stable-diffusion-xl-base-1.0
